# IA generativa e catálogo real inicial, para homologação LOCAL.
# Copie para .env e preencha a chave. Nunca compartilhe .env ou use prefixo VITE_ para segredos.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=
DATABASE_SSL=false
# Banco separado do ambiente demonstrativo anterior.
DATA_DIR=./.data/connected
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Permite a base de conhecimento editorial somente na homologação.
# setup:connected desativa as clínicas fictícias. Produção exige false e conhecimento revisado.
ALLOW_DEMO_DATA=true
AUTO_SEED=false
TRUST_PROXY_HOPS=0
CHAT_RATE_LIMIT=12
AI_MAX_CONCURRENCY=4
