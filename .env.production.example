# Copie para .env no servidor e preencha sem versionar segredos.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
WEB_ORIGIN=https://medfinder.seu-dominio.com.br
DATABASE_URL=postgresql://medfinder:SUBSTITUA@db:5432/medfinder
# true para PostgreSQL gerenciado com TLS; false apenas na rede interna do Compose.
DATABASE_SSL=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
ALLOW_DEMO_DATA=false
AUTO_SEED=false
TRUST_PROXY_HOPS=0
CHAT_RATE_LIMIT=12
AI_MAX_CONCURRENCY=4
# Compose: use a mesma senha na DATABASE_URL.
POSTGRES_PASSWORD=SUBSTITUA
