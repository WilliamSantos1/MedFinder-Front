# Desenvolvimento local: catálogo real + RAG de homologação, sem IA generativa.
# Funciona sem chave ou Docker. AUTO_SEED atualiza a coleção local na inicialização.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=
DATABASE_SSL=false
DATA_DIR=./.data/postgres
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
ALLOW_DEMO_DATA=true
AUTO_SEED=true
TRUST_PROXY_HOPS=0
CHAT_RATE_LIMIT=12
AI_MAX_CONCURRENCY=4
