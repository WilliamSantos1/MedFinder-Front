{
  "name": "medfinder",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch --import tsx server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run build && npm test",
    "db:migrate": "node --import tsx scripts/manage.ts migrate",
    "db:seed": "node --import tsx scripts/manage.ts seed",
    "data:import": "node --import tsx scripts/manage.ts import",
    "rag:reindex": "node --import tsx scripts/manage.ts reindex",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:connected": "node --import tsx scripts/manage.ts setup-connected",
    "setup:check": "node --import tsx scripts/manage.ts check",
    "integrations:check": "node --import tsx scripts/manage.ts check-online",
    "catalog:load": "node --import tsx scripts/manage.ts catalog-load",
    "setup:local": "node --import tsx scripts/manage.ts setup-local",
    "setup:ollama": "node --import tsx scripts/setup-ollama.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "fastify": "^5.12.5",
    "lucide-react": "^1.46.0",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
